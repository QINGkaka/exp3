  },
  "models": {
    "fastwam": {
      "official_smoke": {
        "checkpoint": "REPLACE_ME",
        "dataset_stats": "REPLACE_ME",
        "task_config": "robotwin_uncond_3cam_384_1e-4"
      }
    },
    "openwam": {
      "official_smoke": {
        "checkpoint_dir": "REPLACE_ME",
        "deploy_args": ["--compile-enabled", "false"]
      }
    }
  }
