@@ -83,6 +83,26 @@ def _load_all_tasks() -> list[str]:
     return dedup_tasks
 
 
+def _load_task_file(path_str: str) -> list[str]:
+    task_file = _resolve_path(path_str, base=PROJECT_ROOT)
+    if not task_file.is_file():
+        raise FileNotFoundError(f"Task file not found: {task_file}")
+
+    tasks: list[str] = []
+    seen: set[str] = set()
+    for raw_line in task_file.read_text(encoding="utf-8").splitlines():
+        task = raw_line.split("#", 1)[0].strip()
+        if not task or task in seen:
+            continue
+        if not task.replace("_", "").isalnum():
+            raise ValueError(f"Invalid task name {task!r} in {task_file}")
+        seen.add(task)
+        tasks.append(task)
+    if not tasks:
+        raise ValueError(f"Task file is empty: {task_file}")
+    return tasks
+
+
